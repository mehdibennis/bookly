[run]
source = app
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*
    */venv/*
    */.venv/*
    app/main.py
    app/core/limiter.py
    app/core/logging_config.py
    app/core/middleware.py
    app/core/observability.py
    app/core/sentry_integration.py
    app/core/config.py
parallel = true
concurrency = multiprocessing

[report]
precision = 2
show_missing = true
skip_covered = false
fail_under = 94
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    if settings.DEBUG
    # SQLAdmin initialization

[html]
directory = htmlcov

[paths]
source =
    app/
    /app/app/
